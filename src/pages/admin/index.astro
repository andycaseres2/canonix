---
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../features/admin/components/AdminNav.astro';
import AdminStats from '../../features/admin/components/AdminStats.astro';
import QuickLinks from '../../features/admin/components/QuickLinks.astro';
const { supabase } = Astro.locals;
const c = async (t: string, f?: (q: any) => any) => {
  let q = supabase.from(t).select('*', { count: 'exact', head: true });
  if (f) q = f(q);
  return (await q).count ?? 0;
};
const since = new Date(Date.now() - 7 * 864e5).toISOString();
const [users, comics, animes, routes, units, week] = await Promise.all([
  c('profiles'), c('media', (q) => q.eq('kind', 'comic')), c('media', (q) => q.eq('kind', 'anime')),
  c('routes'), c('units'), c('progress', (q) => q.gte('completed_at', since)),
]);
---
<Layout title="Admin">
  <h1>Panel de administración</h1>
  <AdminNav />
  <AdminStats users={users} comics={comics} animes={animes} routes={routes} units={units} week={week} />
  <h2>Accesos rápidos</h2>
  <QuickLinks />
</Layout>
