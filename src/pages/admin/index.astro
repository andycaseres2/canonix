---
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../components/AdminNav.astro';
const { supabase } = Astro.locals;
const c = async (t: string, f?: (q: any) => any) => {
  let q = supabase.from(t).select('*', { count: 'exact', head: true });
  if (f) q = f(q);
  return (await q).count ?? 0;
};
const since = new Date(Date.now() - 7 * 864e5).toISOString();
const [users, comics, animes, routes, units, week] = await Promise.all([
  c('profiles'), c('media', (q) => q.eq('kind', 'comic')), c('media', (q) => q.eq('kind', 'anime')),
  c('routes'), c('units'), c('progress', (q) => q.gte('completed_at', since)),
]);
---
<Layout title="Admin">
  <h1>Panel de administración</h1>
  <AdminNav />
  <div class="stats">
    <div class="stat"><b>{users}</b>usuarios</div>
    <div class="stat"><b>{comics}</b>cómics</div>
    <div class="stat"><b>{animes}</b>animes</div>
    <div class="stat"><b>{routes}</b>rutas</div>
    <div class="stat"><b>{units}</b>números y episodios</div>
    <div class="stat"><b>{week}</b>marcados esta semana</div>
  </div>
  <h2>Accesos rápidos</h2>
  <div class="row" style="max-width:640px">
    <a class="btn" href="/admin/media/nuevo">Nuevo cómic o anime</a>
    <a class="btn" href="/admin/rutas#nueva">Crear ruta</a>
    <a class="btn" href="/admin/usuarios">Ver usuarios</a>
  </div>
</Layout>
