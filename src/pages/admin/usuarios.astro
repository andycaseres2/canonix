---
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../components/AdminNav.astro';
import { createServiceClient } from '../../lib/supabase';
const { supabase, user } = Astro.locals;
const { data: profiles } = await supabase.from('profiles').select('*').order('created_at', { ascending: false });
const { data: stats } = await supabase.rpc('admin_user_stats');
const byUser = new Map((stats ?? []).map((s: any) => [s.user_id, s]));
const service = createServiceClient();
const banned = new Set<string>();
if (service) {
  const { data } = await service.auth.admin.listUsers({ perPage: 1000 });
  (data?.users ?? []).forEach((u: any) => { if (u.banned_until && new Date(u.banned_until) > new Date()) banned.add(u.id); });
}
const fmt = new Intl.DateTimeFormat('es-CO', { dateStyle: 'medium' });
---
<Layout title="Usuarios · Admin">
  <h1>Usuarios</h1>
  <AdminNav />
  {!service && <p class="alert error">Falta SUPABASE_SERVICE_ROLE_KEY en el .env: puedes cambiar rol y plan, pero no bloquear ni borrar usuarios.</p>}
  <label class="field" style="max-width:420px;margin-bottom:14px">Buscar<input id="f" type="search" autocomplete="off" /></label>
  <div class="table-wrap"><table>
    <thead><tr><th>Usuario</th><th>Registro</th><th>Progreso</th><th>Rol y plan</th><th>Cuenta</th></tr></thead>
    <tbody id="rows">
      {(profiles ?? []).map((p: any) => {
        const s: any = byUser.get(p.id);
        const me = p.id === user?.id;
        return (
          <tr data-s={`${p.display_name ?? ''} ${p.email}`.toLowerCase()}>
            <td><b>{p.display_name}</b>{me && ' (tú)'}<br /><small class="muted">{p.email}</small></td>
            <td>{fmt.format(new Date(p.created_at))}</td>
            <td>{s?.units_done ?? 0}<br /><small class="muted">{s?.last_activity ? fmt.format(new Date(s.last_activity)) : 'sin actividad'}</small></td>
            <td>
              <form method="post" action="/api/admin/users" class="row" style="gap:4px;flex-wrap:nowrap">
                <input type="hidden" name="action" value="update" /><input type="hidden" name="id" value={p.id} />
                <select name="role" aria-label="Rol" disabled={me}><option value="user" selected={p.role === 'user'}>Usuario</option><option value="admin" selected={p.role === 'admin'}>Admin</option></select>
                <select name="plan" aria-label="Plan"><option value="free" selected={p.plan === 'free'}>Gratis</option><option value="premium" selected={p.plan === 'premium'}>Premium</option></select>
                <button class="btn small" type="submit">OK</button>
              </form>
            </td>
            <td style="white-space:nowrap">
              {service && !me && (
                <>
                  <form method="post" action="/api/admin/users" style="display:inline">
                    <input type="hidden" name="action" value={banned.has(p.id) ? 'unban' : 'ban'} /><input type="hidden" name="id" value={p.id} />
                    <button class="btn small" type="submit">{banned.has(p.id) ? 'Desbloquear' : 'Bloquear'}</button>
                  </form>
                  <form method="post" action="/api/admin/users" style="display:inline" onsubmit="return confirm('¿Borrar este usuario y todo su progreso? No se puede deshacer.')">
                    <input type="hidden" name="action" value="delete" /><input type="hidden" name="id" value={p.id} />
                    <button class="btn small danger" type="submit">Borrar</button>
                  </form>
                </>
              )}
              {banned.has(p.id) && <small class="muted"> Bloqueado</small>}
            </td>
          </tr>
        );
      })}
    </tbody>
  </table></div>
  <script>
    const f = document.getElementById('f') as HTMLInputElement;
    f.addEventListener('input', () => {
      const v = f.value.trim().toLowerCase();
      document.querySelectorAll<HTMLElement>('#rows tr').forEach((r) => { r.hidden = !!v && !(r.dataset.s ?? '').includes(v); });
    });
  </script>
</Layout>
