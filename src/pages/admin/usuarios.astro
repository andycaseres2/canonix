---
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../features/admin/components/AdminNav.astro';
import Alert from '../../components/ui/Alert.astro';
import UsersSearch from '../../features/admin-users/components/UsersSearch.astro';
import UsersTable from '../../features/admin-users/components/UsersTable.astro';
import type { UserRowData, UserStats } from '../../features/admin-users/types';
import type { Profile } from '../../lib/types';
import { createServiceClient } from '../../lib/supabase';
const { supabase, user } = Astro.locals;
const { data: profiles } = await supabase.from('profiles').select('*').order('created_at', { ascending: false });
const { data: stats } = await supabase.rpc('admin_user_stats');
const byUser = new Map(((stats ?? []) as UserStats[]).map((s) => [s.user_id, s]));
const service = createServiceClient();
const banned = new Set<string>();
if (service) {
  const { data } = await service.auth.admin.listUsers({ perPage: 1000 });
  (data?.users ?? []).forEach((u: any) => { if (u.banned_until && new Date(u.banned_until) > new Date()) banned.add(u.id); });
}
const rows: UserRowData[] = ((profiles ?? []) as Profile[]).map((p) => ({
  profile: p, stats: byUser.get(p.id), isSelf: p.id === user?.id, banned: banned.has(p.id),
}));
---
<Layout title="Usuarios · Admin">
  <h1>Usuarios</h1>
  <AdminNav />
  {!service && <Alert kind="error">Falta SUPABASE_SERVICE_ROLE_KEY en el .env: puedes cambiar rol y plan, pero no bloquear ni borrar usuarios.</Alert>}
  <UsersSearch />
  <UsersTable rows={rows} canManageAccounts={!!service} />
</Layout>
