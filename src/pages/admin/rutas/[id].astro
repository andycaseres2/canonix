---
import Layout from '../../../layouts/Layout.astro';
import AdminNav from '../../../components/AdminNav.astro';
const { supabase } = Astro.locals;
const { data: r } = await supabase.from('routes').select('*').eq('id', Astro.params.id!).maybeSingle();
if (!r) return Astro.redirect('/admin/rutas?error=' + encodeURIComponent('Ruta no encontrada'));
const { data: items } = await supabase.from('route_items').select('id, section, note, position, media(id, title, year_label, kind)').eq('route_id', r.id).order('position');
const used = new Set((items ?? []).map((i: any) => i.media?.id));
const { data: allMedia } = await supabase.from('media').select('id, title, year_label, kind, universe').order('universe').order('year_start').order('title');
const options = (allMedia ?? []).filter((m) => !used.has(m.id));
const sections = [...new Set((items ?? []).map((i: any) => i.section).filter(Boolean))];
---
<Layout title={`${r.name} · Admin`}>
  <p><a href="/admin/rutas">← Rutas</a></p>
  <h1>{r.name}</h1>
  <AdminNav />
  <div class="split">
    <section>
      <h2 style="margin-top:0">Orden ({items?.length ?? 0})</h2>
      <div class="table-wrap"><table>
        <thead><tr><th>#</th><th>Título</th><th>Sección</th><th>Mover</th><th></th></tr></thead>
        <tbody>
          {(items ?? []).map((it: any, i: number) => (
            <tr>
              <td>{i + 1}</td>
              <td><b>{it.media?.title}</b><br /><small class="muted">{it.media?.year_label}</small></td>
              <td>
                <form method="post" action="/api/admin/route-items" class="row" style="gap:4px;flex-wrap:nowrap">
                  <input type="hidden" name="action" value="section" /><input type="hidden" name="id" value={it.id} /><input type="hidden" name="route_id" value={r.id} />
                  <input name="section" value={it.section ?? ''} list="sections" aria-label="Sección" style="min-width:120px" />
                  <button class="btn small" type="submit">OK</button>
                </form>
              </td>
              <td style="white-space:nowrap">
                {['up', 'down'].map((dir) => (
                  <form method="post" action="/api/admin/route-items" style="display:inline">
                    <input type="hidden" name="action" value="move" /><input type="hidden" name="id" value={it.id} /><input type="hidden" name="route_id" value={r.id} /><input type="hidden" name="dir" value={dir} />
                    <button class="btn small" type="submit" aria-label={dir === 'up' ? 'Subir' : 'Bajar'} disabled={(dir === 'up' && i === 0) || (dir === 'down' && i === (items?.length ?? 0) - 1)}>{dir === 'up' ? '↑' : '↓'}</button>
                  </form>
                ))}
              </td>
              <td>
                <form method="post" action="/api/admin/route-items">
                  <input type="hidden" name="action" value="remove" /><input type="hidden" name="id" value={it.id} /><input type="hidden" name="route_id" value={r.id} />
                  <button class="btn small danger" type="submit">Quitar</button>
                </form>
              </td>
            </tr>
          ))}
        </tbody>
      </table></div>
      <datalist id="sections">{sections.map((s) => <option value={s} />)}</datalist>

      <h3 id="agregar">Agregar a la ruta</h3>
      <div class="panel stack">
        <label class="field">Sección para lo que agregues <small>opcional, ej: "Años 80"</small><input id="add-section" list="sections" /></label>
        <label class="field">Busca por nombre <small>escribe y toca Agregar</small><input id="add-q" type="search" placeholder="Ej: Civil War, Alias, Naruto…" autocomplete="off" /></label>
        <ul id="add-results" class="results" aria-live="polite"></ul>
      </div>

      <h3>Agregar varios de una</h3>
      <form class="panel stack" method="post" action="/api/admin/route-items">
        <input type="hidden" name="action" value="bulk" /><input type="hidden" name="route_id" value={r.id} />
        <label class="field">Un título por línea <small>si hay dos con el mismo nombre, agrega el año ("Thor 1983") o usa su slug</small>
          <textarea name="titles" rows="7" placeholder={'Civil War\nHouse of M\nThor 1983'} required></textarea></label>
        <label class="field">Sección <small>opcional, se aplica a todos</small><input name="section" list="sections" /></label>
        <button class="btn primary" type="submit">Agregar todos al final</button>
      </form>
      <script type="application/json" id="add-data" set:html={JSON.stringify(options.map((m) => ({ id: m.id, t: m.title, y: m.year_label, u: m.universe, k: m.kind }))).replace(/</g, '\\u003c')}></script>
      <script define:vars={{ routeId: r.id }}>
        const all = JSON.parse(document.getElementById('add-data').textContent || '[]');
        const q = document.getElementById('add-q'), out = document.getElementById('add-results'), sec = document.getElementById('add-section');
        const norm = (s) => String(s ?? '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
        const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
        function show() {
          const v = norm(q.value.trim());
          if (!v) { out.innerHTML = ''; return; }
          const hits = all.filter((m) => norm(`${m.t} ${m.y} ${m.u}`).includes(v)).slice(0, 15);
          out.innerHTML = hits.length ? hits.map((m) => `<li><span><b>${esc(m.t)}</b> <span class="muted">${esc(m.y)} · ${esc(m.u)} · ${m.k === 'anime' ? 'anime' : 'cómic'}</span></span>
            <form method="post" action="/api/admin/route-items"><input type="hidden" name="action" value="add"><input type="hidden" name="route_id" value="${routeId}">
            <input type="hidden" name="media_id" value="${m.id}"><input type="hidden" name="section" value=""><button class="btn small primary" type="submit">Agregar</button></form></li>`).join('')
            : '<li class="muted">No hay coincidencias. Puede que ya esté en la ruta o que falte crearlo en el catálogo.</li>';
        }
        q.addEventListener('input', show);
        out.addEventListener('submit', (e) => { e.target.querySelector('[name=section]').value = sec.value; });
        sessionStorage.getItem('add-section') && (sec.value = sessionStorage.getItem('add-section'));
        sec.addEventListener('input', () => sessionStorage.setItem('add-section', sec.value));
        if (location.hash === '#agregar') q.focus();
      </script>
      <p class="muted">¿No está el título? <a href="/admin/media#nuevo">Créalo en el catálogo</a>.</p>
    </section>

    <section>
      <h2 style="margin-top:0">Datos</h2>
      <form class="panel stack" method="post" action="/api/admin/routes">
        <input type="hidden" name="action" value="update" /><input type="hidden" name="id" value={r.id} />
        <label class="field">Nombre<input name="name" value={r.name} required /></label>
        <label class="field">Slug<input name="slug" value={r.slug} required pattern="[a-z0-9-]+" /></label>
        <div class="row">
          <label class="field">Universo<input name="universe" value={r.universe} required /></label>
          <label class="field">Tipo<select name="kind">
            <option value="comic" selected={r.kind === 'comic'}>Cómics</option><option value="anime" selected={r.kind === 'anime'}>Anime</option><option value="mixed" selected={r.kind === 'mixed'}>Mixta</option>
          </select></label>
        </div>
        <div class="row">
          <label class="field">Acceso<select name="requires_plan">
            <option value="free" selected={r.requires_plan === 'free'}>Gratis</option><option value="premium" selected={r.requires_plan === 'premium'}>Premium</option>
          </select></label>
          <label class="field">Orden en la lista<input type="number" name="position" value={r.position} /></label>
        </div>
        <label class="field">Descripción<textarea name="description">{r.description ?? ''}</textarea></label>
        <label class="check"><input type="checkbox" name="published" checked={r.published} /> Publicada</label>
        <button class="btn primary" type="submit">Guardar</button>
      </form>
      <p><a href={`/rutas/${r.slug}`}>Ver ruta ↗</a></p>
      <form method="post" action="/api/admin/routes" onsubmit="return confirm('¿Borrar esta ruta? Los títulos siguen en el catálogo.')">
        <input type="hidden" name="action" value="delete" /><input type="hidden" name="id" value={r.id} />
        <button class="btn small danger" type="submit">Borrar ruta</button>
      </form>
    </section>
  </div>
</Layout>
