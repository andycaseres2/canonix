---
import Layout from '../../../layouts/Layout.astro';
import SectionHead from '../../../components/ui/SectionHead.astro';
import RouteForm from '../../../features/admin-routes/components/RouteForm.astro';
import StageCard from '../../../features/admin-routes/components/StageCard.astro';
import NewStageForm from '../../../features/admin-routes/components/NewStageForm.astro';
import StagePickerData from '../../../features/admin-routes/components/StagePickerData.astro';
import DeleteRouteForm from '../../../features/admin-routes/components/DeleteRouteForm.astro';
import StagePicker from '../../../features/admin-routes/components/StagePicker.astro';
import type { PickerOption, StageItem } from '../../../features/admin-routes/types';
const { supabase } = Astro.locals;
const { data: r } = await supabase.from('routes').select('*').eq('id', Astro.params.id!).maybeSingle();
if (!r) return Astro.redirect('/admin/rutas?error=' + encodeURIComponent('Ruta no encontrada'));
const [{ data: stages }, { data: items }, { data: allMedia }] = await Promise.all([
  supabase.from('route_sections').select('id, title, description, position').eq('route_id', r.id).order('position'),
  supabase.from('route_items').select('id, section_id, position, media(id, title, year_label, kind, cover_url)').eq('route_id', r.id).order('position'),
  supabase.from('media').select('id, title, year_label, kind, universe, cover_url').order('universe').order('year_start').order('title'),
]);
const stageList = stages ?? [];
const byStage = new Map<string, StageItem[]>();
(items ?? []).forEach((it: any) => byStage.set(it.section_id, [...(byStage.get(it.section_id) ?? []), it]));
const used = new Set((items ?? []).map((i: any) => i.media?.id));
const options: PickerOption[] = (allMedia ?? []).filter((m) => !used.has(m.id)).map((m) => ({ id: m.id, t: m.title, y: m.year_label, u: m.universe, k: m.kind, c: m.cover_url }));
---
<Layout title={`${r.name} · Admin`}>
  <p class="back-link"><a href="/admin/rutas">← Rutas</a></p>
  <h1>{r.name}</h1>

  <div class="route-editor" id="route-page">
    <SectionHead title="Ruta"><a class="btn small" href={`/rutas/${r.slug}`}>Ver ruta ↗</a></SectionHead>
    <RouteForm route={r} />

    <h2>Etapas ({stages?.length ?? 0})</h2>
    {stageList.length === 0 && <p class="muted">Crea la primera etapa, por ejemplo «Años 60», y agrégale cómics o mangas.</p>}
    {stageList.map((s, i) => <StageCard routeId={r.id} stage={s} index={i} total={stageList.length} items={byStage.get(s.id) ?? []} />)}

    <NewStageForm routeId={r.id} />
    <StagePickerData options={options} />
    <DeleteRouteForm routeId={r.id} />
  </div>

  <StagePicker routeId={r.id} />
</Layout>
