---
import Layout from '../../../layouts/Layout.astro';
import AdminNav from '../../../features/admin/components/AdminNav.astro';
import RoutesTable from '../../../features/admin-routes/components/RoutesTable.astro';
import CreateRouteForm from '../../../features/admin-routes/components/CreateRouteForm.astro';
const { supabase } = Astro.locals;
const { data: routes } = await supabase.from('routes').select('id, slug, name, universe, kind, published, requires_plan, position, route_sections(count), route_items(count)').order('position').order('name');
---
<Layout title="Rutas · Admin">
  <h1>Rutas</h1>
  <AdminNav />
  <div class="split">
    <section>
      <RoutesTable routes={(routes ?? []) as any[]} />
    </section>
    <CreateRouteForm />
  </div>
</Layout>
