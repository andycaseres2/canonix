---
import Layout from '../../../layouts/Layout.astro';
import AdminNav from '../../../features/admin/components/AdminNav.astro';
import UnitsHeader from '../../../features/admin-titles/components/UnitsHeader.astro';
import UnitsUploadSection from '../../../features/admin-titles/components/UnitsUploadSection.astro';
import UnitsList from '../../../features/admin-titles/components/UnitsList.astro';
import ClearUnitsZone from '../../../features/admin-titles/components/ClearUnitsZone.astro';
import CoverEditor from '../../../features/admin-titles/components/CoverEditor.astro';
import TitleDataForm from '../../../features/admin-titles/components/TitleDataForm.astro';
import DeleteTitleZone from '../../../features/admin-titles/components/DeleteTitleZone.astro';
import type { TitleRecord, TitleUnit, UnitGroup } from '../../../features/admin-titles/types';
const { supabase } = Astro.locals;
const { data } = await supabase.from('media').select('*').eq('id', Astro.params.id!).maybeSingle();
if (!data) return Astro.redirect('/admin/media?error=' + encodeURIComponent('Título no encontrado'));
const m = data as TitleRecord;
const { data: muData } = await supabase.from('media_units').select('unit_id, short, group_name, position, units(label, file_path, file_format)').eq('media_id', m.id).order('position');
// The units join is to-one at runtime, though the generated types infer an array
const mu = (muData ?? []) as unknown as TitleUnit[];
// Consecutive units with the same group name form one group
const groups: UnitGroup[] = [];
mu.forEach((u) => {
  const last = groups[groups.length - 1];
  if (!last || last.name !== u.group_name) groups.push({ name: u.group_name, units: [u] });
  else last.units.push(u);
});
const unitWord = m.kind === 'anime' ? 'episodios' : 'números';
const withFile = mu.filter((u) => u.units?.file_path).length;
// Prefill the series with the name the existing numbers use ("Batman #404" -> "Batman"), else the title
const firstLabel: string | undefined = mu[0]?.units?.label;
const seriesGuess = firstLabel?.match(m.kind === 'anime' ? /^(.*) - Episodio \d+$/ : /^(.*) #\d+$/)?.[1] ?? m.title;
---
<Layout title={`${m.title} · Admin`}>
  <p><a href="/admin/media">← Catálogo</a></p>
  <h1>{m.title}</h1>
  <AdminNav />
  <div class="split">
    <section>
      <UnitsHeader unitWord={unitWord} total={mu.length} withFile={withFile} />
      <UnitsList mediaId={m.id} unitWord={unitWord} groups={groups} />
      <UnitsUploadSection mediaId={m.id} kind={m.kind} unitWord={unitWord} series={seriesGuess} />
      <div id="units-clear">{mu.length > 0 && <ClearUnitsZone mediaId={m.id} unitWord={unitWord} />}</div>
    </section>

    <section>
      <CoverEditor mediaId={m.id} title={m.title} coverUrl={m.cover_url} />
      <TitleDataForm title={m} />
      <DeleteTitleZone mediaId={m.id} />
    </section>
  </div>
</Layout>
