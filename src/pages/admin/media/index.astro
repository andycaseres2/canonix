---
import Layout from '../../../layouts/Layout.astro';
import AdminNav from '../../../features/admin/components/AdminNav.astro';
import TitlesTable from '../../../features/admin-titles/components/TitlesTable.astro';
import NewTitleCta from '../../../features/admin-titles/components/NewTitleCta.astro';
const { supabase } = Astro.locals;
const { data: media } = await supabase.from('media').select('id, slug, kind, universe, title, year_label, media_units(count)').order('kind').order('year_start').order('title');
---
<Layout title="Catálogo · Admin">
  <h1>Catálogo</h1>
  <AdminNav />
  <div class="split">
    <TitlesTable titles={media ?? []} />
    <NewTitleCta />
  </div>
</Layout>
