---
import Layout from '../layouts/Layout.astro';
import LoginForm from '../features/auth/components/LoginForm.astro';
if (Astro.locals.user) return Astro.redirect('/rutas');
const next = Astro.url.searchParams.get('next') ?? '/rutas';
---
<Layout title="Entrar">
  <div class="narrow">
    <h1>Entrar</h1>
    <p class="lead">Entra para guardar lo que vas leyendo y viendo.</p>
    <LoginForm next={next} />
  </div>
</Layout>
