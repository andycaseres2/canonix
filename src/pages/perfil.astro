---
import Layout from '../layouts/Layout.astro';
import ProgressStats from '../features/progress/components/ProgressStats.astro';
import MyRoutes from '../features/progress/components/MyRoutes.astro';
import HistoryTable, { type HistoryEntry } from '../features/progress/components/HistoryTable.astro';
import AccountForm from '../features/progress/components/AccountForm.astro';
import { getDoneUnitIds, getRouteUnitMap, getStartedRoutes } from '../lib/data';
const { supabase, user, profile } = Astro.locals;
const [done, allRoutes, started] = await Promise.all([
  getDoneUnitIds(supabase, user!.id), getRouteUnitMap(supabase), getStartedRoutes(supabase, user!.id),
]);
// Only the routes the user started, most recent first
const routes = allRoutes
  .filter((r) => started.has(r.route.id))
  .sort((a, b) => started.get(b.route.id)!.localeCompare(started.get(a.route.id)!));
const RECENT_LIMIT = 40;
const { data: recent } = await supabase
  .from('progress').select('completed_at, units(label)').eq('user_id', user!.id)
  .order('completed_at', { ascending: false }).limit(RECENT_LIMIT);
// The generated relation type says `units` is an array, but a many-to-one join returns one object.
const history = (recent ?? []) as unknown as HistoryEntry[];
const weekAgo = Date.now() - 7 * 864e5;
const thisWeek = history.filter((r) => new Date(r.completed_at).getTime() > weekAgo).length;
---
<Layout title="Mi progreso">
  <h1>Mi progreso</h1>
  <ProgressStats unitsDone={done.size} thisWeek={thisWeek} thisWeekCapped={thisWeek === RECENT_LIMIT} premium={profile?.plan === 'premium'} />

  <h2>Mis rutas</h2>
  <MyRoutes routes={routes} done={done} started={started} />

  <h2>Historial</h2>
  <HistoryTable entries={history} />

  <h2>Cuenta</h2>
  <AccountForm email={profile?.email} displayName={profile?.display_name ?? ''} />
</Layout>
