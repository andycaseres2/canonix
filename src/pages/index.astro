---
import Layout from '../layouts/Layout.astro';
import HomeHero from '../features/routes/components/HomeHero.astro';
import RouteGrid from '../features/routes/components/RouteGrid.astro';
import CatalogShortcuts from '../features/catalog/components/CatalogShortcuts.astro';
import { getDoneUnitIds, getRouteUnitMap } from '../lib/data';
const { supabase, user, profile } = Astro.locals;
const [routes, done] = await Promise.all([getRouteUnitMap(supabase), getDoneUnitIds(supabase, user?.id)]);
const { count: comics } = await supabase.from('media').select('id', { count: 'exact', head: true }).eq('kind', 'comic');
const { count: animes } = await supabase.from('media').select('id', { count: 'exact', head: true }).eq('kind', 'anime');
---
<Layout title="Inicio">
  <HomeHero profile={profile} showRegister={!user} />

  <h2>Rutas</h2>
  {routes.length === 0 && <p class="muted">Todavía no hay rutas publicadas.</p>}
  <RouteGrid routes={routes} done={done} showProgress={!!user} detailed />

  <h2>Catálogo</h2>
  <CatalogShortcuts comics={comics ?? 0} animes={animes ?? 0} />
</Layout>
