---
import Layout from '../layouts/Layout.astro';
import { getDoneUnitIds, getRouteUnitMap } from '../lib/data';
const { supabase, user, profile } = Astro.locals;
const [routes, done] = await Promise.all([getRouteUnitMap(supabase), getDoneUnitIds(supabase, user?.id)]);
const { count: comics } = await supabase.from('media').select('id', { count: 'exact', head: true }).eq('kind', 'comic');
const { count: animes } = await supabase.from('media').select('id', { count: 'exact', head: true }).eq('kind', 'anime');
---
<Layout title="Inicio">
  <section class="hero">
    <p class="lbl">{profile ? `Hola, ${profile.display_name ?? ''}` : 'Cómics y anime'}</p>
    <p class="big">Lee y mira en el orden correcto</p>
    <p>Rutas de lectura de Marvel, DC y guías de anime. Marca cada número o episodio y lleva tu registro.</p>
    <p class="row" style="max-width:420px">
      <a class="btn" href="/rutas">Ver rutas</a>
      {!user && <a class="btn" href="/registro">Crear cuenta</a>}
    </p>
  </section>

  <h2>Rutas</h2>
  {routes.length === 0 && <p class="muted">Todavía no hay rutas publicadas.</p>}
  <div class="grid">
    {routes.map(({ route, unitIds, count, unitCount }) => {
      const d = unitIds.filter((id) => done.has(id)).length;
      const pct = unitIds.length ? Math.round((d / unitIds.length) * 100) : 0;
      return (
        <a class="card" href={`/rutas/${route.slug}`}>
          <span><span class={`badge ${route.kind === 'anime' ? 'anime' : 'comic'}`}>{route.universe}</span></span>
          <span class="t">{route.name}</span>
          <span class="muted">{route.description}</span>
          <span class="muted">{count} títulos · {unitCount} {route.kind === 'anime' ? 'episodios' : 'números'}</span>
          {user && <><div class="bar"><span style={`width:${pct}%`}></span></div><b>{pct}% completado</b></>}
        </a>
      );
    })}
  </div>

  <h2>Catálogo</h2>
  <div class="grid">
    <a class="card" href="/catalogo?tipo=comic"><span class="badge comic">Cómics</span><span class="t">{comics ?? 0} títulos</span></a>
    <a class="card" href="/catalogo?tipo=anime"><span class="badge anime">Anime</span><span class="t">{animes ?? 0} títulos</span></a>
  </div>
</Layout>
