---
import Layout from '../../layouts/Layout.astro';
import RouteHeader from '../../features/routes/components/RouteHeader.astro';
import RouteStart from '../../features/routes/components/RouteStart.astro';
import LockedNotice from '../../features/routes/components/LockedNotice.astro';
import Tracker from '../../features/routes/components/Tracker.astro';
import { getDoneUnitIds, getRoute, getStartedRoutes } from '../../lib/data';
const { supabase, user, profile } = Astro.locals;
const data = await getRoute(supabase, Astro.params.slug!, profile);
if (!data) return new Response('Ruta no encontrada', { status: 404 });
const { route, items, locked } = data;
const [done, started] = locked
  ? [new Set<string>(), new Map<string, string>()]
  : await Promise.all([getDoneUnitIds(supabase, user?.id), getStartedRoutes(supabase, user?.id)]);
---
<Layout title={route.name} description={route.description ?? undefined}>
  <RouteHeader name={route.name} description={route.description} published={route.published} />
  {!locked && route.published && <RouteStart routeId={route.id} slug={route.slug} loggedIn={!!user} startedAt={started.get(route.id)} />}
  {locked
    ? <LockedNotice />
    : <Tracker items={items} done={[...done]} logged={!!user} />}
</Layout>
