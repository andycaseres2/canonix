---
import Layout from '../../layouts/Layout.astro';
import TitleHero from '../../features/catalog/components/TitleHero.astro';
import Tracker from '../../features/routes/components/Tracker.astro';
import { getDoneUnitIds, getMedia, toTrackerItem } from '../../lib/data';
import type { RouteLink } from '../../features/catalog/types';
const { supabase, user } = Astro.locals;
const m = await getMedia(supabase, Astro.params.slug!);
if (!m) return new Response('Título no encontrado', { status: 404 });
const item = toTrackerItem(m);
const done = await getDoneUnitIds(supabase, user?.id);
const { data: inRoutes } = await supabase.from('route_items').select('routes(slug, name, published)').eq('media_id', m.id);
const routes: RouteLink[] = (inRoutes ?? []).map((r: any) => r.routes).filter((r: any) => r?.published);
---
<Layout title={m.title} description={m.description ?? undefined}>
  <TitleHero media={m} routes={routes} />
  <Tracker items={[item]} done={[...done]} logged={!!user} openFirst showHero={false} />
</Layout>
