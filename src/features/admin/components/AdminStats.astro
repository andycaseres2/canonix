---
// Admin home totals: users, comics, mangas, routes, units and units marked this week.
import StatGrid from '../../../components/ui/StatGrid.astro';
import Stat from '../../../components/ui/Stat.astro';
interface Props { users: number; comics: number; mangas: number; routes: number; units: number; week: number }
const { users, comics, mangas, routes, units, week } = Astro.props;
---
<StatGrid>
  <Stat value={users}>usuarios</Stat>
  <Stat value={comics}>cómics</Stat>
  <Stat value={mangas}>mangas</Stat>
  <Stat value={routes}>rutas</Stat>
  <Stat value={units}>episodios</Stat>
  <Stat value={week}>marcados esta semana</Stat>
</StatGrid>
