---
// Comic/manga radio pair (`fieldset.kind-pick`, field name `kind`); comic is checked by default.
---
<fieldset class="kind-pick">
  <legend class="sr-only">Tipo</legend>
  <label><input type="radio" name="kind" value="comic" checked /> <span>Cómic</span></label>
  <label><input type="radio" name="kind" value="manga" /> <span>Manga</span></label>
</fieldset>
