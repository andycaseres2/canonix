---
import { formatList, pickExtensions } from '../../../lib/uploads';
interface Props {
  kind: 'comic' | 'anime';
  /** Title id. Without it the uploader only collects files and a parent script calls uploadAll(). */
  mediaId?: string;
  series?: string;
}
const { mediaId, kind, series = '' } = Astro.props;
---
<div class="panel stack uploader" id="subir" data-media-id={mediaId ?? ''} data-kind={kind}>
  <div class="dropzone" id="unit-drop">
    <label class="btn primary file-pick">
      Elegir archivos
      <input id="unit-files" type="file" multiple accept={pickExtensions(kind).map((e) => `.${e}`).join(',')} />
    </label>
    <p class="muted">o arrástralos aquí · <span id="unit-formats">{formatList(kind)}</span> · un archivo por episodio</p>
  </div>
  <div class="row">
    <label class="field">Nombre de la serie <small>así se nombra cada uno: "Batman #404"</small><input id="unit-series" maxlength="150" value={series} /></label>
    <label class="field">Grupo <small>opcional: "Temporada 1"</small><input id="unit-group" maxlength="120" /></label>
  </div>
  <div id="unit-queue" class="stack" hidden>
    <div class="table-wrap"><table class="queue">
      <thead><tr><th>Archivo</th><th>N.º</th><th>Estado</th><th></th></tr></thead>
      <tbody></tbody>
    </table></div>
    <div class="form-actions">
      <span class="hint" id="unit-summary"></span>
      <button class="btn" type="button" id="unit-clear">Vaciar lista</button>
      {mediaId && <button class="btn primary" type="button" id="unit-start">Subir</button>}
    </div>
  </div>
</div>

<script>
  import { appDialog, postJson, putFile, reloadWith, type UploadTarget } from '../scripts/upload';
  import { extractPages, isComicArchive, type Page } from '../scripts/archive';
  import { detectNumber, extensionOf, formatBytes, formatList, mapLimit, pickExtensions } from '../../../lib/uploads';

  type Kind = 'comic' | 'anime';
  type Item = { file: File; number: number | null; status: 'pending' | 'converting' | 'uploading' | 'done' | 'error'; progress: number; message: string };

  const box = document.getElementById('subir')!;
  const input = document.getElementById('unit-files') as HTMLInputElement;
  const drop = document.getElementById('unit-drop')!;
  const queue = document.getElementById('unit-queue')!;
  const tbody = queue.querySelector('tbody')!;
  const summary = document.getElementById('unit-summary')!;
  const seriesInput = document.getElementById('unit-series') as HTMLInputElement;
  const groupInput = document.getElementById('unit-group') as HTMLInputElement;
  const startBtn = document.getElementById('unit-start') as HTMLButtonElement | null;
  const clearBtn = document.getElementById('unit-clear') as HTMLButtonElement;
  let kind = box.dataset.kind as Kind;
  let items: Item[] = [];
  let busy = false;

  const exts = () => pickExtensions(kind);

  /** Small DOM builder; text always goes in as text, never as HTML. */
  function el(tag: string, props: Record<string, unknown> = {}, ...children: (Node | string)[]): HTMLElement {
    const node = Object.assign(document.createElement(tag), props);
    node.append(...children);
    return node;
  }

  function add(files: FileList | File[]) {
    for (const file of files) items.push({ file, number: detectNumber(file.name), status: 'pending', progress: 0, message: '' });
    items.sort((a, b) => (a.number ?? Infinity) - (b.number ?? Infinity));
    render();
  }

  function issues() {
    const seen = new Map<number, number>();
    items.forEach((it) => { if (it.number !== null) seen.set(it.number, (seen.get(it.number) ?? 0) + 1); });
    return items.map((it) =>
      !exts().includes(extensionOf(it.file.name)) ? `Formato no válido: usa ${formatList(kind)}`
      : it.number === null ? 'Falta el episodio'
      : seen.get(it.number)! > 1 ? 'Número repetido'
      : '');
  }

  function render() {
    queue.hidden = items.length === 0;
    const problems = issues();
    tbody.replaceChildren(...items.map((it, i) => {
      const num = el('input', { type: 'number', min: '0', max: '99999', value: it.number === null ? '' : String(it.number), disabled: busy || it.status === 'done' }) as HTMLInputElement;
      num.setAttribute('aria-label', `Número de ${it.file.name}`);
      num.addEventListener('change', () => { it.number = num.value === '' ? null : Math.trunc(Number(num.value)); render(); });
      let status: Node;
      if (it.status === 'converting') status = el('span', { className: 'muted' }, 'Preparando páginas…');
      else if (it.status === 'uploading') {
        const bar = el('span'); bar.style.width = `${Math.round(it.progress * 100)}%`;
        status = el('div', { className: 'progress' }, bar);
      } else if (it.status === 'done') status = el('span', { className: 'ok-text' }, '✓ Subido');
      else if (it.status === 'error') status = el('span', { className: 'error-text' }, it.message);
      else status = el('span', { className: problems[i] ? 'error-text' : 'muted' }, problems[i] || 'Listo para subir');
      const remove = el('button', { type: 'button', className: 'btn small', textContent: 'Quitar', disabled: busy || it.status === 'uploading' || it.status === 'converting' });
      remove.addEventListener('click', () => { items.splice(i, 1); render(); });
      return el('tr', {},
        el('td', {}, el('b', { className: 'file-name', textContent: it.file.name, title: it.file.name }), el('br'), el('small', { className: 'muted', textContent: formatBytes(it.file.size) })),
        el('td', { className: 'num-cell' }, num),
        el('td', {}, status),
        el('td', {}, it.status === 'done' ? '' : remove),
      );
    }));
    const pending = items.filter((it) => it.status !== 'done');
    summary.textContent = `${items.length} archivo${items.length === 1 ? '' : 's'} · ${formatBytes(items.reduce((s, it) => s + it.file.size, 0))}`;
    if (startBtn) {
      startBtn.textContent = busy ? 'Subiendo…' : `Subir ${pending.length}`;
      startBtn.disabled = busy || pending.length === 0 || !api.ready();
    }
    clearBtn.disabled = busy;
    box.dispatchEvent(new CustomEvent('queuechange'));
  }

  async function uploadOne(mediaId: string, it: Item) {
    const series = seriesInput.value;
    try {
      if (isComicArchive(it.file)) {
        await uploadPages(mediaId, it, series);
        it.status = 'done';
        render();
        return;
      }
      it.status = 'uploading'; it.progress = 0; render();
      const target = await postJson<UploadTarget>('/api/admin/uploads', { kind: 'unit', media_id: mediaId, number: it.number, series, filename: it.file.name, content_type: it.file.type, size: it.file.size });
      await putFile(target, it.file, (f) => { it.progress = f; render(); });
      await postJson('/api/admin/episodes', { action: 'complete', media_id: mediaId, number: it.number, series, path: target.path, group: groupInput.value });
      it.status = 'done';
    } catch (e) {
      it.status = 'error'; it.message = (e as Error).message;
    }
    render();
  }

  /** A CBZ/CBR is stored one image per page, so the reader shows page 1 without downloading the whole comic. */
  async function uploadPages(mediaId: string, it: Item, series: string) {
    it.status = 'converting'; render();
    const pages: Page[] = await extractPages(it.file);
    const source = extensionOf(it.file.name) === 'cbr' ? 'cbr' : 'cbz';
    const signed = await postJson<{ folder: string; targets: (UploadTarget & { name: string })[] }>('/api/admin/uploads', {
      kind: 'unit-pages', media_id: mediaId, number: it.number, series, source,
      pages: pages.map((p) => ({ name: p.name, content_type: p.blob.type, size: p.blob.size })),
    });
    it.status = 'uploading'; it.progress = 0; render();
    const total = pages.reduce((sum, p) => sum + p.blob.size, 0);
    const sent = new Array<number>(pages.length).fill(0);
    let last = 0;
    const report = () => {
      // Repaint at most every 1% so dozens of parallel pages do not thrash the table
      const progress = sent.reduce((a, b) => a + b, 0) / total;
      if (progress - last >= 0.01 || progress === 1) { last = progress; it.progress = progress; render(); }
    };
    await mapLimit(pages.map((p, i) => ({ p, i, target: signed.targets[i] })), 4, async ({ p, i, target }) => {
      for (let attempt = 1; ; attempt++) {
        try {
          await putFile(target, p.blob, (f) => { sent[i] = f * p.blob.size; report(); });
          sent[i] = p.blob.size; report();
          return;
        } catch (e) {
          if (attempt >= 2) throw new Error(`No se pudo subir la página ${i + 1}: ${(e as Error).message}`);
        }
      }
    });
    await postJson('/api/admin/episodes', { action: 'complete', media_id: mediaId, number: it.number, series, folder: signed.folder, pages: pages.map((p) => p.name), source, group: groupInput.value });
  }

  const warnLeave = (e: BeforeUnloadEvent) => { e.preventDefault(); };

  /** API for the page: the edit page uploads right away, the create page after creating the title. */
  const api = {
    /** True when there are files and every pending one has a valid format and a unique number. */
    ready: () => items.length > 0 && issues().every((p, i) => !p || items[i].status === 'done'),
    hasProblems: () => issues().some((p, i) => p && items[i].status !== 'done'),
    count: () => items.filter((it) => it.status !== 'done').length,
    setKind(next: Kind) {
      kind = next;
      input.accept = exts().map((e) => `.${e}`).join(',');
      document.getElementById('unit-formats')!.textContent = formatList(kind);
      render();
    },
    series: seriesInput,
    async uploadAll(mediaId: string) {
      busy = true; render();
      addEventListener('beforeunload', warnLeave);
      for (const it of items.filter((x) => x.status !== 'done')) await uploadOne(mediaId, it);
      removeEventListener('beforeunload', warnLeave);
      busy = false; render();
      return { done: items.filter((x) => x.status === 'done').length, failed: items.filter((x) => x.status === 'error').length };
    },
  };
  (box as HTMLElement & { unitQueue?: typeof api }).unitQueue = api;

  startBtn?.addEventListener('click', async () => {
    const { done, failed } = await api.uploadAll(box.dataset.mediaId!);
    if (!failed) return reloadWith('ok', `Se subieron ${done} archivo${done === 1 ? '' : 's'}.`, '#units-head');
    await appDialog().alert({ title: 'Algunos archivos fallaron', message: `Se subieron ${done}. Fallaron ${failed}: revisa el motivo en la lista y vuelve a intentarlo.` });
  });
  clearBtn.addEventListener('click', () => { items = []; render(); });
  input.addEventListener('change', () => { if (input.files) add(input.files); input.value = ''; });
  ['dragenter', 'dragover'].forEach((t) => drop.addEventListener(t, (e) => { e.preventDefault(); drop.classList.add('over'); }));
  ['dragleave', 'drop'].forEach((t) => drop.addEventListener(t, () => drop.classList.remove('over')));
  drop.addEventListener('drop', (e) => { e.preventDefault(); if (!busy && e.dataTransfer?.files.length) add(e.dataTransfer.files); });
</script>
