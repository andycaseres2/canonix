---
// "Agregar episodios" / "Agregar tomos" heading, format hint and the file uploader for an existing title.
import UnitUploader from './UnitUploader.astro';
import { UNIT_FORMAT_LIST } from '../../../lib/uploads';
import { unitWords } from '../../../lib/kinds';
interface Props { mediaId: string; unitType: string; series: string }
const { mediaId, unitType, series } = Astro.props;
const words = unitWords(unitType);
---
<h2 style="margin-top:0">Agregar {words.many}</h2>
<p class="muted" style="margin-top:0">Un archivo ({UNIT_FORMAT_LIST}) por cada {words.one}. El número se toma del nombre del archivo y puedes corregirlo antes de subir.</p>
<UnitUploader mediaId={mediaId} unitType={unitType} series={series} />
