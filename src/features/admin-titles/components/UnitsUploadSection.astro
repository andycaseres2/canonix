---
// "Subir números/episodios" heading, format hint and the file uploader for an existing title.
import UnitUploader from './UnitUploader.astro';
import { formatList } from '../../../lib/uploads';
import type { TitleKind } from '../types';
interface Props { mediaId: string; kind: TitleKind; unitWord: string; series: string }
const { mediaId, kind, unitWord, series } = Astro.props;
---
<h3 style="margin-top:0">Subir {unitWord}</h3>
<p class="muted" style="margin-top:0">Un archivo ({formatList(kind)}) por cada {kind === 'anime' ? 'episodio' : 'número'}. El número se toma del nombre del archivo y puedes corregirlo antes de subir.</p>
<UnitUploader mediaId={mediaId} kind={kind} series={series} />
