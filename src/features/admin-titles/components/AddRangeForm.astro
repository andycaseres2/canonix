---
// Adds a numbered range of units without files (e.g. "#1" to "#12") at the end of the title.
import Panel from '../../../components/ui/Panel.astro';
import Field from '../../../components/ui/Field.astro';
import FormActions from '../../../components/ui/FormActions.astro';
import type { TitleKind } from '../types';
interface Props { mediaId: string; kind: TitleKind; title: string }
const { mediaId, kind, title } = Astro.props;
---
<h3>Agregar un rango sin archivos</h3>
<Panel as="form" data-swap="#units-head, #units-list" class="stack" method="post" action="/api/admin/units">
  <input type="hidden" name="action" value="add_range" /><input type="hidden" name="media_id" value={mediaId} />
  <Field label="Nombre de la serie" hint="Ej: Ultimate Spider-Man, Naruto Shippuden"><input name="prefix" value={title} required /></Field>
  <div class="row">
    <Field label="Desde"><input type="number" name="from" min="0" value="1" required /></Field>
    <Field label="Hasta"><input type="number" name="to" min="0" required /></Field>
    <Field label="Formato"><select name="format">
      <option value="issue" selected={kind === 'comic'}>#5 (números)</option>
      <option value="episode" selected={kind === 'anime'}>Episodio 5</option>
    </select></Field>
  </div>
  <label class="field">Grupo <small>opcional: "Temporada 1", "Arco Chunin"…</small><input name="group" /></label>
  <FormActions hint="Se agregan al final, en orden.">
    <button class="btn primary" type="submit">Agregar rango</button>
  </FormActions>
</Panel>
