---
// "Portada" section of a title (`#portada`): preview, upload with progress, link form and remove button.
import SectionHead from '../../../components/ui/SectionHead.astro';
import Panel from '../../../components/ui/Panel.astro';
interface Props { mediaId: string; title: string; coverUrl: string | null }
const { mediaId, title, coverUrl } = Astro.props;
---
<SectionHead title="Portada" />
<Panel class="cover-editor" id="portada" data-media-id={mediaId}>
  <div class="cover-preview">
    {coverUrl ? <img src={coverUrl} alt={`Portada de ${title}`} /> : <span class="muted">Sin portada</span>}
  </div>
  <div class="stack">
    <label class="btn primary file-pick">
      {coverUrl ? 'Cambiar portada' : 'Subir portada'}
      <input id="cover-file" type="file" accept="image/*" />
    </label>
    <div class="progress" id="cover-progress" hidden><span></span></div>
    <small class="muted">JPG, PNG o WEBP de hasta 5 MB. Mejor en vertical (2:3).</small>
    <details class="cover-link">
      <summary>O usa un link a una imagen</summary>
      <form id="cover-link-form" class="row" style="margin-top:8px">
        <input name="url" type="url" placeholder="https://" required aria-label="Link de la portada" />
        <button class="btn small" type="submit">Usar link</button>
      </form>
    </details>
    {coverUrl && <button class="btn small danger" type="button" id="cover-remove">Quitar portada</button>}
  </div>
</Panel>

<script>
  import { appDialog, postJson, putFile, reloadWith, type UploadTarget } from '../scripts/upload';
  import { compressCover } from '../scripts/compress';
  const box = document.getElementById('portada')!;
  const mediaId = box.dataset.mediaId!;
  const input = document.getElementById('cover-file') as HTMLInputElement;
  const progress = document.getElementById('cover-progress')!;
  const bar = progress.querySelector('span')!;
  const fail = (e: unknown) => appDialog().alert({ title: 'No se pudo', message: (e as Error).message });

  input.addEventListener('change', async () => {
    const picked = input.files?.[0];
    input.value = '';
    if (!picked) return;
    if (!picked.type.startsWith('image/')) return fail(new Error('La portada debe ser una imagen (JPG, PNG, WEBP…).'));
    if (picked.size > 5 * 1024 * 1024) return fail(new Error('La portada pesa más de 5 MB.'));
    progress.hidden = false;
    bar.style.width = '0%';
    const file = await compressCover(picked);
    try {
      const target = await postJson<UploadTarget>('/api/admin/uploads', { kind: 'cover', media_id: mediaId, filename: file.name, content_type: file.type, size: file.size });
      await putFile(target, file, (f) => { bar.style.width = `${Math.round(f * 100)}%`; });
      await postJson('/api/admin/covers', { action: 'complete', media_id: mediaId, path: target.path });
      reloadWith('ok', 'Portada actualizada.', '#portada');
    } catch (e) {
      progress.hidden = true;
      fail(e);
    }
  });

  document.getElementById('cover-link-form')!.addEventListener('submit', async (e) => {
    e.preventDefault();
    const url = new FormData(e.target as HTMLFormElement).get('url');
    try {
      await postJson('/api/admin/covers', { action: 'link', media_id: mediaId, url });
      reloadWith('ok', 'Portada actualizada.', '#portada');
    } catch (err) { fail(err); }
  });

  document.getElementById('cover-remove')?.addEventListener('click', async () => {
    const yes = await appDialog().confirm({ title: '¿Quitar portada?', message: 'El título se queda sin imagen. Puedes subir otra cuando quieras.', confirmLabel: 'Quitar portada', danger: true });
    if (!yes) return;
    try {
      await postJson('/api/admin/covers', { action: 'remove', media_id: mediaId });
      reloadWith('ok', 'Portada quitada.', '#portada');
    } catch (err) { fail(err); }
  });
</script>
