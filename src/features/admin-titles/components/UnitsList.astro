---
// Units of a title (`#units-list`): grouped cards with their file and a remove button.
import UnitCard from './UnitCard.astro';
import type { UnitGroup } from '../types';
interface Props { mediaId: string; unitWord: string; groups: UnitGroup[] }
const { mediaId, unitWord, groups } = Astro.props;
---
<div id="units-list">
{groups.length === 0 && <p class="muted">Aún no tiene {unitWord}. Súbelos abajo.</p>}
{groups.map((g) => (
  <div style="margin-bottom:14px">
    {g.name && <p class="muted" style="margin:0 0 6px;font-weight:700">{g.name}</p>}
    <ul class="unit-cards">
      {g.units.map((u) => <UnitCard mediaId={mediaId} unit={u} />)}
    </ul>
  </div>
))}
</div>
