---
// Adds one loose unit (e.g. a special) by full label and button text.
import Panel from '../../../components/ui/Panel.astro';
import Field from '../../../components/ui/Field.astro';
import FormActions from '../../../components/ui/FormActions.astro';
interface Props { mediaId: string }
const { mediaId } = Astro.props;
---
<h3>Agregar uno suelto</h3>
<Panel as="form" data-swap="#units-head, #units-list" class="stack" method="post" action="/api/admin/units">
  <input type="hidden" name="action" value="add_one" /><input type="hidden" name="media_id" value={mediaId} />
  <div class="row">
    <Field label="Nombre completo"><Fragment slot="hint">único, con el título: "Giant-Size X-Men #1", no solo "1"</Fragment><input name="label" required /></Field>
    <Field label="Texto del botón"><input name="short" placeholder="Especial" /></Field>
  </div>
  <FormActions>
    <button class="btn" type="submit">Agregar</button>
  </FormActions>
</Panel>
