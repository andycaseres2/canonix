---
// One unit chip with a file dot when it has a file and a remove (×) form.
import type { TitleUnit } from '../types';
interface Props { mediaId: string; unit: TitleUnit }
const { mediaId, unit: u } = Astro.props;
---
<span class={`chip-admin${u.units?.file_path ? ' has-file' : ''}`} title={u.units?.file_path ? `${u.units?.label} · ${u.units.file_format?.toUpperCase()}` : u.units?.label}>{u.units?.file_path && <span class="file-dot" aria-label="Tiene archivo"></span>}{u.short}
  <form data-swap="#units-head, #units-list, #units-clear" method="post" action="/api/admin/units">
    <input type="hidden" name="action" value="remove" /><input type="hidden" name="media_id" value={mediaId} /><input type="hidden" name="unit_id" value={u.unit_id} />
    <button type="submit" aria-label={`Quitar ${u.units?.label}`}>×</button>
  </form>
</span>
