---
// In-app viewer: comic pages one at a time with keyboard, tap and fit controls, or a video player for episodes.
// Comics stored by pages load only the pages being read; PDFs load by ranges; older single CBZ files are downloaded whole.
interface Props { url: string | null; pages: string[] | null; format: string; storageKey: string; nextHref: string | null; nextLabel: string | null }
const { url, pages, format, storageKey, nextHref, nextLabel } = Astro.props;
const isVideo = ['mp4', 'webm', 'mkv'].includes(format);
---
{isVideo ? (
  <div class="reader-video">
    <video controls playsinline preload="metadata" src={url ?? undefined}></video>
    {format === 'mkv' && <p class="muted">Si no se reproduce, tu navegador no soporta MKV. Prueba con Chrome.</p>}
  </div>
) : (
  <section class="viewer" id="viewer" data-url={url ?? undefined} data-pages={pages ? JSON.stringify(pages) : undefined} data-format={format} data-key={storageKey} aria-label="Lector">
    <div class="viewer-status" id="viewer-status" role="status">
      <p id="viewer-status-text">Cargando…</p>
      <div class="progress"><span id="viewer-progress"></span></div>
    </div>
    <!-- The page fills the width and scrolls inside this box; tapping its left or right third turns the page -->
    <div class="viewer-stage" id="viewer-stage" hidden></div>
    <div class="viewer-controls" id="viewer-controls" hidden>
      <button class="btn small" type="button" data-go="-1" aria-label="Página anterior">‹</button>
      <span class="viewer-count" id="viewer-count" aria-live="polite"></span>
      <button class="btn small" type="button" data-go="1" aria-label="Página siguiente">›</button>
      <button class="btn small" type="button" id="viewer-full">Pantalla completa</button>
      {nextHref && <a class="btn small primary" id="viewer-next" href={nextHref} hidden>Siguiente: {nextLabel} ›</a>}
    </div>
  </section>
)}

<script>
  // Only the worker's url: pdf.js itself loads on demand, for PDF files
  import pdfWorkerUrl from 'pdfjs-dist/build/pdf.worker.min.mjs?url';
  import { comicPages, imageType } from '../pages';

  /** A comic opened in memory: how many pages it has and how to draw one. */
  type Book = { count: number; draw(index: number, width: number): Promise<HTMLElement> };

  const store = {
    get: (k: string) => { try { return localStorage.getItem(k); } catch { return null; } },
    set: (k: string, v: string) => { try { localStorage.setItem(k, v); } catch { /* private mode */ } },
  };

  async function download(url: string, onProgress: (got: number, total: number) => void) {
    const res = await fetch(url);
    if (!res.ok || !res.body) throw new Error(`El servidor respondió ${res.status}.`);
    const total = Number(res.headers.get('Content-Length')) || 0;
    const reader = res.body.getReader();
    const chunks: Uint8Array[] = [];
    let got = 0;
    for (;;) {
      const { done, value } = await reader.read();
      if (done) break;
      chunks.push(value);
      got += value.length;
      onProgress(got, total);
    }
    const bytes = new Uint8Array(got);
    let at = 0;
    for (const c of chunks) { bytes.set(c, at); at += c.length; }
    return bytes;
  }

  async function openCbz(bytes: Uint8Array): Promise<Book> {
    const { unzip } = await import('fflate');
    const files = await new Promise<Record<string, Uint8Array>>((resolve, reject) =>
      unzip(bytes, { filter: (f) => comicPages([f.name]).length === 1 }, (err, data) => (err ? reject(err) : resolve(data))));
    const names = comicPages(Object.keys(files));
    const urls = new Map<number, string>();
    const urlOf = (i: number) => {
      if (!urls.has(i)) urls.set(i, URL.createObjectURL(new Blob([files[names[i]] as BlobPart], { type: imageType(names[i]) })));
      return urls.get(i)!;
    };
    return {
      count: names.length,
      async draw(i) {
        const img = new Image();
        img.src = urlOf(i);
        await img.decode().catch(() => undefined);
        // Warm up the next page so turning feels instant
        if (i + 1 < names.length) new Image().src = urlOf(i + 1);
        return img;
      },
    };
  }

  /** Pages stored as images: each one is fetched when shown, the next two are preloaded, far ones are let go. */
  function openPaged(urls: string[]): Book {
    const loaded = new Map<number, HTMLImageElement>();
    const load = (i: number) => {
      if (!loaded.has(i)) {
        const img = new Image();
        img.decoding = 'async';
        img.src = urls[i];
        loaded.set(i, img);
      }
      return loaded.get(i)!;
    };
    return {
      count: urls.length,
      async draw(i) {
        const img = load(i);
        // A page that failed is forgotten, so coming back to it tries again
        await img.decode().catch(() => { if (!img.naturalWidth) { loaded.delete(i); throw new Error('page'); } });
        [i + 1, i + 2].filter((j) => j < urls.length).forEach(load);
        // Keep decoded images only around the current page; the browser cache still has the bytes
        for (const j of loaded.keys()) if (j < i - 2 || j > i + 3) loaded.delete(j);
        return img;
      },
    };
  }

  /** PDFs load by HTTP ranges: pdf.js asks only for the parts of the file the shown pages need. */
  async function openPdf(url: string, onProgress: (got: number, total: number) => void): Promise<Book> {
    const pdfjs = await import('pdfjs-dist');
    pdfjs.GlobalWorkerOptions.workerSrc = pdfWorkerUrl;
    const task = pdfjs.getDocument({ url, disableAutoFetch: true, disableStream: true, rangeChunkSize: 1 << 20 });
    task.onProgress = ({ loaded, total }: { loaded: number; total: number }) => onProgress(loaded, total);
    const doc = await task.promise;
    return {
      count: doc.numPages,
      async draw(i, width) {
        const page = await doc.getPage(i + 1);
        // Render at the stage width (sharp on retina, capped for memory); CSS scales it like an image
        const base = page.getViewport({ scale: 1 });
        const scale = Math.min((width * devicePixelRatio) / base.width, 2400 / base.width);
        const viewport = page.getViewport({ scale });
        const canvas = document.createElement('canvas');
        canvas.width = Math.floor(viewport.width);
        canvas.height = Math.floor(viewport.height);
        await page.render({ canvas, viewport }).promise;
        return canvas;
      },
    };
  }

  async function open(root: HTMLElement) {
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const status = $('viewer-status'), statusText = $('viewer-status-text'), bar = $('viewer-progress');
    const stage = $('viewer-stage'), controls = $('viewer-controls'), count = $('viewer-count');
    const full = $<HTMLButtonElement>('viewer-full');
    const nextLink = document.getElementById('viewer-next');
    const { url, format, key } = root.dataset as { url: string; format: string; key: string };
    const mb = (n: number) => (n / 1024 / 1024).toFixed(1);
    const progress = (verb: string) => (got: number, total: number) => {
      statusText.textContent = total ? `${verb} ${mb(got)} de ${mb(total)} MB…` : `${verb} ${mb(got)} MB…`;
      if (total) bar.style.width = `${Math.round((got / total) * 100)}%`;
    };

    let book: Book;
    try {
      if (root.dataset.pages) book = openPaged(JSON.parse(root.dataset.pages) as string[]);
      else if (format === 'pdf') book = await openPdf(url, progress('Cargando'));
      else if (format === 'cbr') throw new Error('Este número está en formato CBR y no se puede abrir. Hay que volver a subirlo.');
      else {
        // Older issues stored as one CBZ: the whole archive is needed before any page
        const bytes = await download(url, progress('Descargando'));
        statusText.textContent = 'Abriendo…';
        book = await openCbz(bytes);
      }
      if (!book.count) throw new Error('El archivo no tiene páginas.');
    } catch (e) {
      statusText.textContent = e instanceof Error && e.message ? e.message : 'No pudimos abrir el archivo.';
      status.classList.add('failed');
      return;
    }

    status.hidden = true;
    stage.hidden = false;
    controls.hidden = false;

    // Size the page box to what the sticky header and the controls leave free, then bring the viewer just under the header
    const header = document.querySelector<HTMLElement>('.site-header');
    const fitScreen = () => root.style.setProperty('--viewer-chrome', `${(header?.offsetHeight ?? 0) + controls.offsetHeight + 12}px`);
    fitScreen();
    addEventListener('resize', fitScreen);
    scrollTo({ top: root.getBoundingClientRect().top + scrollY - (header?.offsetHeight ?? 0) - 6 });

    let page = Math.min(Math.max(Number(store.get(key)) || 0, 0), book.count - 1);
    let drawing = 0;
    const show = async (i: number) => {
      page = Math.min(Math.max(i, 0), book.count - 1);
      const ticket = ++drawing;
      count.textContent = `${page + 1} / ${book.count}`;
      store.set(key, String(page));
      if (nextLink) nextLink.hidden = page < book.count - 1;
      let el: HTMLElement;
      try {
        el = await book.draw(page, stage.clientWidth);
      } catch {
        el = Object.assign(document.createElement('p'), { className: 'viewer-page-error', textContent: `No se pudo mostrar la página ${page + 1}.` });
      }
      if (ticket !== drawing) return; // a later turn already won
      el.classList.add('viewer-page');
      el.setAttribute('aria-label', `Página ${page + 1} de ${book.count}`);
      stage.replaceChildren(el);
      stage.scrollTop = 0;
    };
    const go = (delta: number) => show(page + delta);

    controls.querySelectorAll<HTMLButtonElement>('[data-go]').forEach((b) => b.addEventListener('click', () => go(Number(b.dataset.go))));
    // A tap (not a scroll) on the left or right third of the page turns it
    stage.addEventListener('click', (e) => {
      const x = (e.clientX - stage.getBoundingClientRect().left) / stage.clientWidth;
      if (x < 1 / 3) go(-1);
      else if (x > 2 / 3) go(1);
    });
    addEventListener('keydown', (e) => {
      if ((e.target as HTMLElement).closest('input, textarea, select') || e.altKey || e.metaKey || e.ctrlKey) return;
      if (e.key === 'ArrowRight') { e.preventDefault(); go(1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(-1); }
    });

    full.hidden = !document.fullscreenEnabled;
    full.addEventListener('click', () => (document.fullscreenElement ? document.exitFullscreen() : root.requestFullscreen()));
    document.addEventListener('fullscreenchange', () => { full.textContent = document.fullscreenElement ? 'Salir de pantalla completa' : 'Pantalla completa'; });

    await show(page);
  }

  // Last, so every helper above is initialized: paged comics open without awaiting anything first
  const viewer = document.getElementById('viewer');
  if (viewer) open(viewer);
</script>
