---
// Catalog card grid (`#list`) with its empty state. CatalogSearch filters the cards by their `data-s` (shell/ListFilter).
import CardGrid from '../../../components/ui/CardGrid.astro';
import CatalogCard from './CatalogCard.astro';
import type { CatalogMedia } from '../types';
interface Props { media: CatalogMedia[] }
const { media } = Astro.props;
---
<CardGrid id="list">
  {media.map((m) => <CatalogCard media={m} />)}
</CardGrid>
{media.length === 0 && <p class="muted">No hay títulos todavía.</p>}
