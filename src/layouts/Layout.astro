---
import '../styles/global.css';
import AppDialog from '../components/shell/AppDialog.astro';
import FormSwap from '../components/shell/FormSwap.astro';
import ListFilter from '../components/shell/ListFilter.astro';
import SiteHeader from '../components/shell/SiteHeader.astro';
import DemoBanner from '../components/shell/DemoBanner.astro';
import FlashMessages from '../components/shell/FlashMessages.astro';
import { USE_MOCK } from '../lib/config';
import { DEMO_ACCOUNTS, DEMO_PASSWORD } from '../lib/mock/seed';
interface Props { title: string; description?: string }
const { title, description = 'Rutas de lectura de cómics y guías de anime, con tu progreso guardado.' } = Astro.props;
const { profile, user } = Astro.locals;
const ok = Astro.url.searchParams.get('ok');
const error = Astro.url.searchParams.get('error');
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#FFC93C" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bangers&family=Atkinson+Hyperlegible:wght@400;700&display=swap" rel="stylesheet" />
  <title>{title} · Rutas</title>
</head>
<body>
  {USE_MOCK && <DemoBanner emails={DEMO_ACCOUNTS.map((a) => a.email)} password={DEMO_PASSWORD} />}
  <SiteHeader signedIn={!!user} isAdmin={profile?.role === 'admin'} />
  <main>
    <div class="wrap">
      <FlashMessages ok={ok} error={error} />
      <slot />
    </div>
  </main>
  <AppDialog />
  <FormSwap />
  <ListFilter />
</body>
</html>
